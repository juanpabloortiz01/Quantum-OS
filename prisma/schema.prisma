generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- MODELOS DE AUTENTICACIÓN (Auth.js) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Para login con contraseña (encriptada)
  
  // Relación con Quantum
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- MODELOS DE NEGOCIO (Quantum) ---

model Organization {
  id                      String   @id @default(cuid())
  name                    String
  whatsappNumber          String   @unique
  evolutionInstance       String?
  planTier                String   @default("FREE")
  paymentValidationsCount Int      @default(0)
  paymentModuleLocked     Boolean  @default(false)
  onboardingStep          Int      @default(0)
  protocolActive          Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relaciones
  users          User[]
  businessConfig BusinessConfig?
  paymentLogs    PaymentLog[]
  chatHistory    ChatHistory[]
}

model BusinessConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  niche          String       @default("GASTRONOMY")
  config         Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PaymentLog {
  id                      String       @id @default(cuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId                 String?
  voucherImageUrl         String?
  ocrRawText              String?
  ocrAmount               Float?
  ocrBankName             String?
  ocrTransactionRef       String?
  ocrDatetime             DateTime?
  ocrConfidence           Float?
  isDuplicate             Boolean      @default(false)
  duplicateOfId           String?
  emailVerificationStatus String       @default("PENDING")
  emailVerifiedAt         DateTime?
  validationStatus        String       @default("PROCESSING")
  validatedAt             DateTime?
  rejectionReason         String?
  createdAt               DateTime     @default(now())

  @@unique([organizationId, ocrTransactionRef])
  @@index([organizationId, validationStatus])
}

model ChatHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerPhone  String
  role           String
  content        String
  embedding      Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, customerPhone])
}
