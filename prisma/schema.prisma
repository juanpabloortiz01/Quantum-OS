generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // <-- Añadido para que conecte con Easypanel
}

model Organization {
  id                      String          @id @default(cuid())
  name                    String
  whatsappNumber          String?         @unique // <-- Opcional (?) para no romper el Onboarding
  evolutionInstance       String?
  planTier                String          @default("FREE")
  paymentValidationsCount Int             @default(0)
  paymentModuleLocked     Boolean         @default(false)
  onboardingStep          Int             @default(0)
  protocolActive          Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  businessConfig BusinessConfig?
  paymentLogs    PaymentLog[]
  chatHistory    ChatHistory[]
}

model BusinessConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  niche          String       @default("GASTRONOMY")
  config         Json         @default("{}") // Aquí guardaremos los enabled_nodes
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PaymentLog {
  id                      String       @id @default(cuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId                 String?
  voucherImageUrl         String?
  ocrRawText              String?
  ocrAmount               Float?
  ocrBankName             String?
  ocrTransactionRef       String?
  ocrDatetime             DateTime?
  ocrConfidence           Float?
  isDuplicate             Boolean      @default(false)
  duplicateOfId           String?
  emailVerificationStatus String       @default("PENDING")
  emailVerifiedAt         DateTime?
  validationStatus        String       @default("PROCESSING")
  validatedAt             DateTime?
  rejectionReason         String?
  createdAt               DateTime     @default(now())

  @@unique([organizationId, ocrTransactionRef])
  @@index([organizationId, validationStatus])
}

model ChatHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerPhone  String
  role           String
  content        String
  embedding      Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, customerPhone])
}