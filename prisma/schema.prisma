generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ── AUTH.JS REQUIRED MODELS ──────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Solo para login con credenciales
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  organization  Organization?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── QUANTUM MODELS ───────────────────────────────────────────────
model Organization {
  id                      String   @id @default(cuid())
  name                    String
  whatsappNumber          String   @unique
  evolutionInstance       String?
  evolutionToken          String?
  planTier                String   @default("FREE")
  paymentValidationsCount Int      @default(0)
  paymentModuleLocked     Boolean  @default(false)
  onboardingStep          Int      @default(0)
  protocolActive          Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relación con el usuario dueño
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessConfig BusinessConfig?
  paymentLogs    PaymentLog[]
  chatHistory    ChatHistory[]
  products       Product[]
  leads          Lead[]
  reservas       Reserva[]
}

model BusinessConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  niche          String       @default("GASTRONOMY")
  config         Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PaymentLog {
  id                      String    @id @default(cuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId                 String?
  voucherImageUrl         String?
  ocrRawText              String?
  ocrAmount               Float?
  ocrBankName             String?
  ocrTransactionRef       String?
  ocrDatetime             DateTime?
  ocrConfidence           Float?
  isDuplicate             Boolean   @default(false)
  duplicateOfId           String?
  emailVerificationStatus String    @default("PENDING")
  emailVerifiedAt         DateTime?
  validationStatus        String    @default("PROCESSING")
  validatedAt             DateTime?
  rejectionReason         String?
  createdAt               DateTime  @default(now())

  @@unique([organizationId, ocrTransactionRef])
  @@index([organizationId, validationStatus])
}

model ChatHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerPhone  String
  role           String
  content        String
  embedding      Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, customerPhone])
}

model Product {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  imageUrl        String
  category        String?
  primaryColor    String?
  secondaryColor  String?
  brand           String?
  characteristics String?
  style           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerPhone  String
  name           String       @default("Desconocido")
  trustScore     Int          @default(0)
  intent         String       @default("UNKNOWN")
  summary        String?
  agentActive    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, customerPhone])
}

model Reserva {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cliente_id            String
  cliente_nombre        String
  cantidad_personas     Int
  fecha_hora_deseada    DateTime
  estado                String       @default("pendiente_aprobacion")
  propuesta_alternativa DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([organizationId])
  @@index([fecha_hora_deseada])
}
